<idea-plugin>
    <!-- IMMUTABLE after the first Marketplace upload. See MARKETPLACE-SETUP.md. -->
    <id>com.kitworks.tablekit</id>
    <name>TableKit: Excel &amp; Parquet Viewer</name>

    <!-- TODO: switch the email to support@kitworks.* once the domain is registered,
         and make sure the url points to a PUBLIC repo before the first upload. -->
    <vendor email="michalvesecky@gmail.com" url="https://github.com/SpdVpr/tablekit">Kitworks</vendor>

    <description><![CDATA[
        <p><b>Open Parquet, Excel, CSV, TSV and JSON Lines files directly in your IDE</b> - no row limits,
        no freezes, no data ever leaving your machine.</p>

        <p>TableKit turns any data file into a fast, scrollable table. Powered by an embedded DuckDB engine,
        it streams only the rows you are looking at, so a multi-gigabyte Parquet file opens as quickly as
        a small CSV.</p>

        <h3>Features</h3>
        <ul>
            <li><b>Parquet viewer</b> - full file, not the first 10&nbsp;000 rows</li>
            <li><b>Excel viewer</b> - .xlsx and .xlsm workbooks, sheet by sheet</li>
            <li><b>CSV, TSV and JSON Lines</b> - opened as an extra tab, your usual editor stays the default</li>
            <li><b>Sort and filter</b> pushed down to the query engine, not to your heap</li>
            <li><b>Schema and column statistics</b> - types, nullability, nulls, distinct values, min/max</li>
            <li><b>Nested types</b> (struct, list, map) rendered as readable JSON</li>
        </ul>

        <h3>Private by design</h3>
        <p>TableKit requests <b>no network permissions</b>. Nothing is uploaded, no telemetry is collected,
        and nothing is downloaded at runtime. Your data stays on your disk.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.TableKitBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Binary formats: TableKit becomes the default editor. Registering the
             file types also makes the IDE suggest the plugin to users who open one. -->
        <fileType name="TableKit Parquet"
                  implementationClass="com.kitworks.tablekit.filetype.ParquetFileType"
                  fieldName="INSTANCE"
                  extensions="parquet;parq;pq"/>
        <fileType name="TableKit Excel"
                  implementationClass="com.kitworks.tablekit.filetype.ExcelFileType"
                  fieldName="INSTANCE"
                  extensions="xlsx;xlsm"/>
        <fileType name="TableKit Avro"
                  implementationClass="com.kitworks.tablekit.filetype.AvroFileType"
                  fieldName="INSTANCE"
                  extensions="avro"/>
        <fileType name="TableKit ORC"
                  implementationClass="com.kitworks.tablekit.filetype.OrcFileType"
                  fieldName="INSTANCE"
                  extensions="orc"/>

        <fileEditorProvider implementation="com.kitworks.tablekit.editor.BinaryTabularFileEditorProvider"/>
        <fileEditorProvider implementation="com.kitworks.tablekit.editor.TextTabularFileEditorProvider"/>
    </extensions>

    <actions>
        <!-- CSV and friends keep their own editor, so the grid sits on a second
             tab. Without this action nobody would know it is there. -->
        <action id="TableKit.OpenIn"
                class="com.kitworks.tablekit.actions.OpenInTableKitAction"
                text="Open in TableKit"
                description="Open this file as a table in TableKit">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
